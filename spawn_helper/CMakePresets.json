{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21
  },
  "configurePresets": [
    {
      "name": "linux-x86_64",
      "hidden": false,
      "generator": "Ninja",
      "environment": {
        "CC": "${sourceDir}/zig-cc.cmd",
        "CXX": "${sourceDir}/zig-c++.cmd"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "x86_64",
        "CMAKE_C_COMPILER_TARGET": "x86_64-linux-musl",
        "CMAKE_CXX_COMPILER_TARGET": "x86_64-linux-musl"
      }
    },
    {
      "name": "linux-aarch64",
      "hidden": false,
      "generator": "Ninja",
      "environment": {
        "CC": "${sourceDir}/zig-cc.cmd",
        "CXX": "${sourceDir}/zig-c++.cmd"
      },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Linux",
        "CMAKE_SYSTEM_PROCESSOR": "aarch64",
        "CMAKE_C_COMPILER_TARGET": "aarch64-linux-musl",
        "CMAKE_CXX_COMPILER_TARGET": "aarch64-linux-musl"
      }
    }
  ]
}
